---
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Sigil from '../components/Sigil.astro';
import { SITE_TAGLINE, SITE_TITLE } from '../site';
import { url } from '../lib';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  image?: { src: string; width: number; height: number; alt: string };
  // The 404 page: kept out of search results and given no canonical URL.
  noindex?: boolean;
}

const {
  title,
  description = SITE_TAGLINE,
  type = 'website',
  published,
  image = {
    src: url('og-card.png'),
    width: 1200,
    height: 630,
    alt: `${SITE_TITLE}: a gold circuit-trace sigil on black`,
  },
  noindex = false,
} = Astro.props;
const ogTitle = title ?? SITE_TITLE;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    {
      type === 'article' && published && (
        <meta property="article:published_time" content={published.toISOString()} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {/* Gold accent: Discord paints the embed's side stripe with it. */}
    <meta name="theme-color" content="#ffd700" />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL(url('rss.xml'), Astro.site)}
    />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={url()}>
        <Sigil size={34} />
        <span>{SITE_TITLE}</span>
      </a>
      <p class="tagline">{SITE_TAGLINE}</p>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <ul class="footer-links">
        <li><a href={url('about/')}>About</a></li>
        <li><a href={url('rss.xml')}>RSS</a></li>
        <li><a href="https://thenighthouse.org/">The Night House</a></li>
        <li><a href="https://github.com/lbds137">GitHub</a></li>
      </ul>
      {/* The end year comes from the build, so each deploy keeps it current. */}
      <p class="copyright">© 2013–{new Date().getFullYear()} Vladlena Costescu</p>
    </footer>
  </body>
</html>
