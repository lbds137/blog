---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, url } from '../../lib';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
// Posts moved from Blogger keep their history; newer posts carry the how-it's-written footer.
const fromBlogger = Boolean(post.data.originalUrl);
---

<Base title={post.data.title}>
  <article>
    <h1>{post.data.title}</h1>
    <p class="post-meta">
      {fromBlogger ? 'Originally published' : 'Published'}{' '}
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {/* Not a link: the old Blogger address now redirects back to this page. */}
      {fromBlogger && ' on Blogger'}
    </p>
    {
      post.data.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {post.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
    <Content />
    {
      !fromBlogger && (
        <p class="post-footer">
          Drafted with Claude from my ideas, then read, revised and approved by me.{' '}
          <a href={url('about/')}>How posts get written here.</a>
        </p>
      )
    }
  </article>
</Base>
