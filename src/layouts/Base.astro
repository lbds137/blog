---
import '../styles/global.css';
import { SITE_TAGLINE, SITE_TITLE } from '../site';
import { url } from '../lib';

interface Props {
  title?: string;
  description?: string;
  // The 404 page: kept out of search results and given no canonical URL.
  noindex?: boolean;
}

const { title, description = SITE_TAGLINE, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
      )
    }
    <!-- No icon yet; without this the browser asks the lbds137.github.io root, another repo. -->
    <link rel="icon" href="data:," />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={url()}>{SITE_TITLE}</a>
      <p class="tagline">{SITE_TAGLINE}</p>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
