---
import { getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, postDescription, postTitle, url } from '../../lib';
import { SITE_TITLE } from '../../site';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
// Without a front-matter image, the preview is the post's generated card (src/pages/og/).
const img = post.data.image
  ? await getImage({
      src: post.data.image,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpg',
    })
  : undefined;
// Posts moved from Blogger keep their history; newer posts carry the how-it's-written footer.
const fromBlogger = Boolean(post.data.originalUrl);
const title = postTitle(post);
---

<Base
  title={title}
  description={postDescription(post)}
  type="article"
  published={post.data.date}
  image={img
    ? { src: img.src, width: 1200, height: 630, alt: title }
    : {
        src: url(`og/${post.id}.png`),
        width: 1200,
        height: 630,
        alt: `${title}: the post's title and summary on a ${SITE_TITLE} card`,
      }}
>
  <article>
    <h1>{title}</h1>
    <p class="post-meta">
      {fromBlogger ? 'Originally published' : 'Published'}{' '}
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {/* Not a link: the old Blogger address now redirects back to this page. */}
      {fromBlogger && ' on Blogger'}
    </p>
    {
      post.data.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {post.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
    <Content />
    {
      !fromBlogger && (
        <p class="post-footer">
          Drafted with Claude from my ideas, then read, revised, and approved by me.{' '}
          <a href={url('about/')}>How posts get written here.</a>
        </p>
      )
    }
  </article>
</Base>
