---
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Sigil from '../components/Sigil.astro';
import { SITE_TAGLINE, SITE_TITLE } from '../site';
import { url } from '../lib';

interface Props {
  title?: string;
  description?: string;
  // The 404 page: kept out of search results and given no canonical URL.
  noindex?: boolean;
}

const { title, description = SITE_TAGLINE, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
      )
    }
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={url()}>
        <Sigil size={34} />
        <span>{SITE_TITLE}</span>
      </a>
      <p class="tagline">{SITE_TAGLINE}</p>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
